{
    "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single"
        }
    },
    "linter": {
        "enabled": false
    },
    "files": {
        "includes": [
            "src/**/*.ts",
            "*.ts",
            "*.mjs",
            "scripts/**/*.mjs",
            "*.json",
            "!**/dist/**",
            "!**/node_modules/**",
            "!**/ob_vault/**",
            "!**/.github/**",
            "!skills-lock.json"
        ]
    }
}
