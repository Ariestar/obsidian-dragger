{
    "name": "obsidian-dragger",
    "version": "1.3.4",
    "description": "Drag and drop any block to rearrange content in Obsidian",
    "repository": {
        "type": "git",
        "url": "https://github.com/Ariestar/obsidian-dragger"
    },
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "node esbuild.config.mjs production",
        "lint": "eslint src --ignore-pattern \"**/*.spec.ts\" --config eslint.config.mjs",
        "lint:fix": "eslint src --ignore-pattern \"**/*.spec.ts\" --config eslint.config.mjs --fix",
        "lint:review": "eslint src --ignore-pattern \"**/*.spec.ts\" --config eslint.config.mjs --max-warnings=0",
        "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "keywords": [
        "obsidian",
        "plugin",
        "drag-drop",
        "blocks"
    ],
    "author": "Ariestar",
    "license": "MIT",
    "dependencies": {
        "md-dragger": "file:../md-dragger"
    },
    "devDependencies": {
        "@codemirror/state": "^6.0.0",
        "@codemirror/view": "^6.0.0",
        "@types/node": "^16.11.6",
        "esbuild": "^0.17.3",
        "eslint": "^9.38.0",
        "eslint-plugin-obsidianmd": "^0.3.0",
        "jsdom": "^22.1.0",
        "obsidian": "latest",
        "tslib": "^2.4.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.55.0",
        "vitest": "^0.34.6"
    }
}
