{
    "name": "obsidian-dragger",
    "version": "1.3.4",
    "description": "Drag and drop any block to rearrange content in Obsidian",
    "repository": {
        "type": "git",
        "url": "https://github.com/Ariestar/obsidian-dragger"
    },
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "node esbuild.config.mjs production",
        "lint": "eslint src --ignore-pattern \"**/*.spec.ts\" --config eslint.config.mjs",
        "lint:fix": "eslint src --ignore-pattern \"**/*.spec.ts\" --config eslint.config.mjs --fix",
        "lint:review": "eslint src --ignore-pattern \"**/*.spec.ts\" --config eslint.config.mjs --max-warnings=0",
        "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "format": "biome format --write",
        "format:check": "biome format --changed",
        "smoke:npm": "node scripts/smoke.mjs",
        "check:versions": "node scripts/check-versions.mjs",
        "prepare": "husky",
        "postinstall": "node scripts/link-md.mjs"
    },
    "lint-staged": {
        "*.ts": [
            "eslint --fix --config eslint.config.mjs --ignore-pattern \"**/*.spec.ts\"",
            "biome format --write"
        ],
        "*.{mjs,json}": "biome format --write"
    },
    "keywords": [
        "obsidian",
        "plugin",
        "drag-drop",
        "blocks"
    ],
    "author": "Ariestar",
    "license": "MIT",
    "engines": {
        "node": ">=22.12.0"
    },
    "packageManager": "pnpm@11.19.0",
    "dependencies": {
        "md-dragger": "^1.3.4"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.6",
        "@codemirror/state": "^6.7.1",
        "@codemirror/view": "^6.43.6",
        "@types/node": "^24.13.3",
        "esbuild": "^0.28.1",
        "eslint": "^9.38.0",
        "eslint-plugin-obsidianmd": "^0.3.0",
        "husky": "^9.1.7",
        "jsdom": "^30.0.1",
        "lint-staged": "^17.2.0",
        "obsidian": "latest",
        "tslib": "^2.4.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.55.0",
        "vitest": "^4.1.10"
    }
}
