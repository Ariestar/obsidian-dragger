{
    "compilerOptions": {
        "baseUrl": ".",
        "inlineSourceMap": true,
        "inlineSources": true,
        "module": "ESNext",
        "target": "ES6",
        "allowJs": true,
        "noImplicitAny": true,
        "moduleResolution": "bundler",
        "importHelpers": true,
        "isolatedModules": true,
        "strictNullChecks": true,
        "lib": [
            "DOM",
            "ES5",
            "ES6",
            "ES7",
            "ES2021"
        ],
        "paths": {
            "@codemirror/state": ["node_modules/@codemirror/state"],
            "@codemirror/view": ["node_modules/@codemirror/view"]
        }
    },
    "include": [
        "src/**/*.ts"
    ]
}