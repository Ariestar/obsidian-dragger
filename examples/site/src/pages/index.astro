---
import '@/styles/global.css';
import { Card, CardContent } from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';
---

<!DOCTYPE html>
<html lang="zh-CN" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Drag and drop any block to rearrange your markdown content in Obsidian">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <title>Dragger - Block Drag & Drop for Markdown</title>
</head>
<body class="min-h-screen bg-background text-foreground antialiased">
    <div class="mx-auto max-w-4xl px-6 py-16">
        <!-- Hero -->
        <header class="text-center mb-16">
            <Badge variant="secondary" className="mb-4">Obsidian Plugin</Badge>
            <h1 class="text-5xl font-bold tracking-tight mb-4 bg-gradient-to-r from-blue-400 to-violet-400 bg-clip-text text-transparent">
                Dragger
            </h1>
            <p class="text-lg text-muted-foreground max-w-lg mx-auto mb-8">
                像 Notion 一样拖拽排列你的 Markdown 内容块
            </p>
            <div class="flex items-center justify-center gap-3">
                <a href="https://obsidian.md/plugins?id=dragger"
                   class="inline-flex items-center gap-2 rounded-lg bg-primary px-5 py-2.5 text-sm font-medium text-primary-foreground hover:opacity-90 transition-opacity">
                    Install in Obsidian
                </a>
                <a href="https://github.com/Ariestar/obsidian-dragger"
                   class="inline-flex items-center gap-2 rounded-lg border border-border px-5 py-2.5 text-sm font-medium text-foreground hover:bg-accent transition-colors">
                    GitHub
                </a>
            </div>
        </header>

        <!-- Demo -->
        <section class="mb-16">
            <div class="flex items-center justify-between mb-4">
                <div>
                    <h2 class="text-xl font-semibold mb-1">Try it</h2>
                    <p class="text-sm text-muted-foreground">
                        Hover the left edge of any block to reveal the drag handle, then drag to rearrange.
                    </p>
                </div>
                <a href="/playground"
                   class="inline-flex items-center gap-1.5 rounded-md border border-border px-3 py-1.5 text-xs font-medium text-muted-foreground hover:text-foreground hover:bg-accent transition-colors">
                    Full screen →
                </a>
            </div>
            <div class="rounded-xl border border-border bg-card overflow-hidden">
                <div id="editor" class="min-h-[400px]"></div>
            </div>
        </section>

        <!-- Features -->
        <section class="mb-16">
            <h2 class="text-xl font-semibold mb-6">Features</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <Card className="bg-card">
                    <CardContent className="pt-6">
                        <div class="text-2xl mb-3">⠿</div>
                        <h3 class="font-medium mb-1">Block Drag & Drop</h3>
                        <p class="text-sm text-muted-foreground">Drag paragraphs, headings, lists, code blocks, and more.</p>
                    </CardContent>
                </Card>
                <Card className="bg-card">
                    <CardContent className="pt-6">
                        <div class="text-2xl mb-3">☰</div>
                        <h3 class="font-medium mb-1">Multi-block Selection</h3>
                        <p class="text-sm text-muted-foreground">Long-press to select multiple blocks and move them together.</p>
                    </CardContent>
                </Card>
                <Card className="bg-card">
                    <CardContent className="pt-6">
                        <div class="text-2xl mb-3">↗</div>
                        <h3 class="font-medium mb-1">Cross-file Drag</h3>
                        <p class="text-sm text-muted-foreground">Drag blocks between open editors, links, and file explorer.</p>
                    </CardContent>
                </Card>
                <Card className="bg-card">
                    <CardContent className="pt-6">
                        <div class="text-2xl mb-3">📱</div>
                        <h3 class="font-medium mb-1">Mobile Support</h3>
                        <p class="text-sm text-muted-foreground">Full touch support with long-press gestures and haptic feedback.</p>
                    </CardContent>
                </Card>
            </div>
        </section>

        <!-- Footer -->
        <footer class="text-center text-sm text-muted-foreground border-t border-border pt-8">
            <p>Built by <a href="https://github.com/Ariestar" class="text-foreground hover:underline">Ariestar</a></p>
        </footer>
    </div>

    <script>
        import { ink } from 'ink-mde';

        const sampleDoc = `# Welcome to Dragger

Drag any block by its handle to rearrange content. Try it now!

## Features

- Drag paragraphs, headings, lists, code blocks
- Multi-block selection with long press
- Cross-file drag support
- Works on both desktop and mobile

## How to Use

Hover over the left edge of any block to reveal the drag handle. Click and drag to move the block.

> This is a blockquote. Grab its handle and move it around.

\`\`\`javascript
const greeting = "Hello, Dragger!";
console.log(greeting);
\`\`\`

1. First ordered item
2. Second ordered item
3. Third ordered item
`;

        ink(document.getElementById('editor')!, {
            doc: sampleDoc,
            interface: {
                appearance: 'dark',
                toolbar: true,
                attribution: false,
            },
        });
    </script>
</body>
</html>
