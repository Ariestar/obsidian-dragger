---
interface Props {
    title: string;
    description?: string;
}

const { title, description = 'Drag and drop any block to rearrange your markdown content' } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={description}>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <title>{title}</title>
</head>
<body>
    <slot />
</body>
</html>

<style is:global>
    *, *::before, *::after {
        box-sizing: border-box;
    }

    :root {
        --bg-primary: #1e1e2e;
        --bg-secondary: #181825;
        --bg-editor: #11111b;
        --text-normal: #cdd6f4;
        --text-muted: #6c7086;
        --text-faint: #45475a;
        --accent: #89b4fa;
        --accent-dim: rgba(137, 180, 250, 0.15);
        --border: #313244;
        --font-mono: 'JetBrains Mono', 'Fira Code', 'Cascadia Code', monospace;
        --font-ui: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        --radius: 10px;
    }

    body {
        margin: 0;
        padding: 0;
        background: var(--bg-primary);
        color: var(--text-normal);
        font-family: var(--font-ui);
        line-height: 1.6;
    }

    a {
        color: var(--accent);
        text-decoration: none;
    }

    a:hover {
        text-decoration: underline;
    }
</style>
